# Google OAuth 2.0 sozlamalari (Ixtiyoriy)
# Agar Google Cloud Console (https://console.cloud.google.com) dan OAuth 2.0 Client ID olsangiz:
# 1. Authorized redirect URIs ga: http://localhost:3000/api/auth/google/callback qo'shing
# 2. Quyidagi kalitlarni to'ldiring:

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_URL=http://localhost:3000

# Resend Email xizmati sozlamalari (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Animeko <onboarding@resend.dev>

